# Copied to the Mac Mini as .env by deploy.sh.
# Non-secret values: edit here, commit, redeploy.
# Secret values: placeholders below are replaced by deploy.sh from 1Password
#   (op://Personal/Minecraft ESA Server/password).
#   Never put real secrets in this file.

# Host path on the Mac Mini for nightly backups (separate from the family server's)
BACKUP_DIR=/Volumes/X9/backups/minecraft-esa

# World seed. Must be set before the first deploy: the world is generated from
# it once and it cannot be changed afterwards. Why this one: docs/project-status.md
# "World seed". Checked on Chunkbase for 26.2 on 2026-09-29.
SEED=-5228782230889826103

# Java usernames allowed to join (comma-separated, no spaces). Collect them
# through parents. Bedrock players go in with 'fwhitelist add', not here.
WHITELIST=Senior_Huevo,Wheafus

# Moderators (comma-separated, no spaces). The ONLY source of ops: anyone opped
# in game is removed at the next restart.
OPS=Senior_Huevo,Wheafus

# Secrets (filled by deploy.sh). Values must contain only letters, digits, - and _.
RCON_PASSWORD=__OP_RCON_PASSWORD__
